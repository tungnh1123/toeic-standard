PORT=3000
NODE_ENV=development

# Database PostgreSQL 16 (Hỗ trợ cả kết nối rời hoặc URL Cloud như Neon/Supabase/Render)
# DATABASE_URL=postgresql://user:password@ep-host.neon.tech/toeic_db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=rl_admin
DB_PASSWORD=admin
DB_NAME=toeic_db
DB_SSL=false

# Redis (Dùng cho BullMQ Queue)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & JWT
JWT_SECRET=toeic-master-super-secret-key-2026

# Storage AWS S3 / Cloudflare R2
S3_BUCKET_URL=https://s3.ap-southeast-1.amazonaws.com/toeic-storage
