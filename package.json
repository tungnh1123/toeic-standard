{
  "name": "toeic-standard",
  "version": "1.0.0",
  "description": "Online TOEIC Learning & Exam Preparation System",
  "private": true,
  "scripts": {
    "build": "nest build && cd web && npm install --include=dev && npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "import:oxford": "ts-node src/scripts/import-oxford-matrix.ts",
    "seed:admin": "node src/scripts/seed-admin-teacher.js"
  },
  "dependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/typeorm": "^10.0.1",
    "@tanstack/react-query": "^5.28.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "lucide-react-native": "^0.363.0",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "^0.3.20",
    "typescript": "^5.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "neon": "^8.10.1",
    "prettier": "^3.2.5"
  }
}
